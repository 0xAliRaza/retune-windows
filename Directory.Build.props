<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <!-- Required for IDE0005 (unused usings) to run on build; public XML docs are encouraged, not mandatory. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Company>Retune</Company>
    <Product>Retune</Product>
    <Copyright>GPL-3.0-or-later</Copyright>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) or $(MSBuildProjectName.EndsWith('.E2E'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) or $(MSBuildProjectName.EndsWith('.E2E'))">
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Repository-wide paths used by projects that ship or test the native player -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <LibMpvDir>$(RepoRoot)third_party\libmpv\</LibMpvDir>
  </PropertyGroup>
</Project>
