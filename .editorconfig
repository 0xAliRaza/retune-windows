root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,xml,xaml,json,yml,yaml,slnx}]
indent_size = 2

[*.{ps1,cmd,bat}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Layout
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:warning

# Language
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_prefer_simple_using_statement = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# Naming: _camelCase private fields, PascalCase constants
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel
dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_rule.constants.symbols = constants
dotnet_naming_rule.constants.style = pascal
dotnet_naming_rule.constants.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case

# Ordering matters: constants rule must win over the private field rule
dotnet_naming_rule.constants.priority = 1
dotnet_naming_rule.private_fields.priority = 2

# Unused code is an error, not noise
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0060.severity = warning

# Analyzer tuning
dotnet_diagnostic.CA1515.severity = none   # app types don't need to be internal-only
dotnet_diagnostic.CA1848.severity = none   # LoggerMessage source-gen is used where logging is hot, not everywhere
dotnet_diagnostic.CA2007.severity = none   # no ConfigureAwait noise; library code that needs it opts in

[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none   # Test_names_with_underscores read well
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1861.severity = none   # constant arrays inline in test data are fine
