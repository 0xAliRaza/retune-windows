<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:Retune.App.Controls"
    xmlns:vm="clr-namespace:Retune.Presentation.ViewModels;assembly=Retune.Presentation">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Styles.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- Context menu shared by tiles and rows. DataContext = the ShellViewModel (via the button's Tag). -->
  <ContextMenu x:Key="ItemMenu" x:Shared="False" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
    <MenuItem Header="Play" Command="{Binding PlayCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
      <MenuItem.Icon><ui:SymbolIcon Symbol="Play24" /></MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="Show Details" Command="{Binding OpenCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
              Visibility="{Binding PlacementTarget.DataContext.Kind, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Movie}">
      <MenuItem.Icon><ui:SymbolIcon Symbol="Info24" /></MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="Add to Favorites" Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
              Visibility="{Binding PlacementTarget.DataContext.IsFavorite, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
      <MenuItem.Icon><ui:SymbolIcon Symbol="Star24" /></MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="Remove from Favorites" Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
              Visibility="{Binding PlacementTarget.DataContext.IsFavorite, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibility}}">
      <MenuItem.Icon><ui:SymbolIcon Symbol="StarOff24" /></MenuItem.Icon>
    </MenuItem>
    <MenuItem Header="Mark as Watched / Unwatched" Command="{Binding ToggleWatchedCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
              Visibility="{Binding PlacementTarget.DataContext.Kind, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Movie}">
      <MenuItem.Icon><ui:SymbolIcon Symbol="CheckmarkCircle24" /></MenuItem.Icon>
    </MenuItem>
  </ContextMenu>

  <!-- ===================================================== poster (movies, series) -->
  <DataTemplate x:Key="PosterTile" DataType="{x:Type vm:BrowseItemViewModel}">
    <StackPanel ToolTip="{Binding Title}">
      <Grid>
        <Border Style="{StaticResource TileFrame}">
          <c:AspectBox Ratio="1.5">
            <Border c:RoundedClip.Radius="10">
              <Grid>
                <c:ArtworkImage Source="{Binding Artwork}" Title="{Binding Title}" Initials="{Binding Initials}" PixelSize="420" />
                <!-- badges -->
                <StackPanel Margin="7" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal">
                  <Border Padding="6,2" Background="{StaticResource BadgeBackgroundBrush}" CornerRadius="9" Visibility="{Binding RatingText, Converter={StaticResource HasValueToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource GlyphFilled}" Text="{c:Glyph Star16, Filled=True}" FontSize="11" Foreground="{StaticResource RatingBrush}" />
                      <TextBlock Margin="3,0,0,0" FontSize="11" FontWeight="Bold" Foreground="White" Text="{Binding RatingText}" />
                    </StackPanel>
                  </Border>
                  <Border Width="22" Height="22" Margin="4,0,0,0" Background="{StaticResource BadgeBackgroundBrush}" CornerRadius="11" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource GlyphFilled}" Text="{c:Glyph Star16, Filled=True}" FontSize="12" Foreground="{StaticResource RatingBrush}" />
                  </Border>
                </StackPanel>
                <Border Margin="0,0,7,7" Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{StaticResource BadgeBackgroundBrush}" CornerRadius="9"
                        Visibility="{Binding IsWatched, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Style="{StaticResource Glyph}" Text="{c:Glyph Checkmark16}" FontSize="12" Foreground="White" />
                </Border>
                <!-- hover play (movies play directly) -->
                <Border Width="52" Height="52" Background="#99000000" CornerRadius="26" Style="{StaticResource HoverOnly}"
                        Visibility="{Binding Kind, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Movie}">
                  <TextBlock Style="{StaticResource GlyphFilled}" Text="{c:Glyph Play24, Filled=True}" FontSize="24" Foreground="White" Margin="3,0,0,0" />
                </Border>
                <ProgressBar Style="{StaticResource TileProgress}" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}" />
              </Grid>
            </Border>
          </c:AspectBox>
        </Border>
        <Border Style="{StaticResource FocusRing}" />
      </Grid>
      <TextBlock Margin="2,8,2,0" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="36" />
      <TextBlock Margin="2,1,2,0" Style="{StaticResource Caption}" Text="{Binding TileCaption}" Visibility="{Binding TileCaption, Converter={StaticResource HasValueToVisibility}}" />
    </StackPanel>
  </DataTemplate>

  <!-- ===================================================== logo (live channels) -->
  <DataTemplate x:Key="LogoTile" DataType="{x:Type vm:BrowseItemViewModel}">
    <StackPanel ToolTip="{Binding Title}">
      <Grid>
        <Border x:Name="Frame" Style="{StaticResource TileFrame}" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <c:AspectBox Ratio="0.625">
            <Grid>
              <c:ArtworkImage Margin="16" Source="{Binding Artwork}" Title="{Binding Title}" Initials="{Binding Initials}" PixelSize="300" Stretch="Uniform" ShowPlaceholder="False" />
              <TextBlock Style="{StaticResource Glyph}" Text="{c:Glyph Tv24}" FontSize="28" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding Artwork, Converter={StaticResource HasValueToVisibility}, ConverterParameter=invert}" />
              <TextBlock Style="{StaticResource GlyphFilled}" Text="{c:Glyph Star16, Filled=True}" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="13" Foreground="{StaticResource RatingBrush}" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" />
              <Border Width="40" Height="40" Background="#99000000" CornerRadius="20" Style="{StaticResource HoverOnly}">
                <TextBlock Style="{StaticResource GlyphFilled}" Text="{c:Glyph Play24, Filled=True}" FontSize="20" Foreground="White" Margin="2,0,0,0" />
              </Border>
            </Grid>
          </c:AspectBox>
        </Border>
        <Border Style="{StaticResource FocusRing}" />
      </Grid>
      <StackPanel Margin="2,8,2,0" Orientation="Horizontal">
        <TextBlock Margin="0,0,6,0" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Number}" VerticalAlignment="Center" />
        <TextBlock x:Name="Name" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </StackPanel>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsPlaying}" Value="True">
        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter TargetName="Frame" Property="BorderThickness" Value="2.5" />
        <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- ===================================================== landscape (continue watching) -->
  <DataTemplate x:Key="LandscapeTile" DataType="{x:Type vm:BrowseItemViewModel}">
    <StackPanel ToolTip="{Binding Title}">
      <Grid>
        <Border Style="{StaticResource TileFrame}">
          <c:AspectBox Ratio="0.5625">
            <Border c:RoundedClip.Radius="10">
              <Grid>
                <c:ArtworkImage Source="{Binding Artwork}" Title="{Binding Title}" Initials="{Binding Initials}" PixelSize="600" />
                <Border Background="#33000000" />
                <Border Width="48" Height="48" Background="#99000000" CornerRadius="24">
                  <TextBlock Style="{StaticResource GlyphFilled}" Text="{c:Glyph Play24, Filled=True}" FontSize="22" Foreground="White" Margin="3,0,0,0" />
                </Border>
                <ProgressBar Margin="10" Style="{StaticResource TileProgress}" Value="{Binding Progress, Mode=OneWay}" />
              </Grid>
            </Border>
          </c:AspectBox>
        </Border>
        <Border Style="{StaticResource FocusRing}" />
      </Grid>
      <TextBlock Margin="2,8,2,0" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
      <TextBlock Margin="2,1,2,0" Style="{StaticResource Caption}" Text="{Binding Subtitle}" />
    </StackPanel>
  </DataTemplate>

  <c:TileTemplateSelector x:Key="TileSelector" Poster="{StaticResource PosterTile}" Logo="{StaticResource LogoTile}" Landscape="{StaticResource LandscapeTile}" />

  <!-- ===================================================== list row -->
  <DataTemplate x:Key="ListRowTemplate" DataType="{x:Type vm:BrowseItemViewModel}">
    <Grid MinHeight="46">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="44" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Number}" />
      <Border Grid.Column="1" Margin="0,4,12,4" Background="{DynamicResource ControlFillColorSecondaryBrush}" c:RoundedClip.Radius="5">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="34" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Style}" Value="Poster">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="60" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Style}" Value="Landscape">
                <Setter Property="Width" Value="80" />
                <Setter Property="Height" Value="45" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <c:ArtworkImage x:Name="Thumb" Source="{Binding Artwork}" Title="{Binding Title}" Initials="{Binding Initials}" PixelSize="140" />
          <TextBlock Style="{StaticResource Glyph}" Text="{c:Glyph Tv20}" FontSize="16" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding Artwork, Converter={StaticResource HasValueToVisibility}, ConverterParameter=invert}" />
        </Grid>
      </Border>
      <StackPanel Grid.Column="2" VerticalAlignment="Center">
        <TextBlock x:Name="Name" Style="{StaticResource Body}" Text="{Binding Title}" />
        <TextBlock x:Name="Sub" Style="{StaticResource Caption}" Text="{Binding Subtitle}" Visibility="{Binding Subtitle, Converter={StaticResource HasValueToVisibility}}" />
        <TextBlock x:Name="NowPlaying" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="Now playing" Visibility="Collapsed" />
      </StackPanel>
      <ProgressBar Grid.Column="3" Margin="12,0" Style="{StaticResource ListProgress}" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}" />
      <StackPanel Grid.Column="4" Margin="12,0" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding RatingText, Converter={StaticResource HasValueToVisibility}}">
        <TextBlock Style="{StaticResource GlyphFilled}" Text="{c:Glyph Star16, Filled=True}" FontSize="12" Foreground="{StaticResource RatingBrush}" />
        <TextBlock Margin="4,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding RatingText}" />
      </StackPanel>
      <TextBlock Style="{StaticResource GlyphFilled}" Text="{c:Glyph Star20, Filled=True}" x:Name="Fav" Grid.Column="5" Margin="8,0" FontSize="16" Foreground="{StaticResource RatingBrush}" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsPlaying}" Value="True">
        <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
        <Setter TargetName="Sub" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="NowPlaying" Property="Visibility" Value="Visible" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Style}" Value="Logo">
        <Setter TargetName="Thumb" Property="Stretch" Value="Uniform" />
        <Setter TargetName="Thumb" Property="Margin" Value="4" />
        <Setter TargetName="Thumb" Property="ShowPlaceholder" Value="False" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- ===================================================== compact row -->
  <DataTemplate x:Key="CompactRowTemplate" DataType="{x:Type vm:BrowseItemViewModel}">
    <Grid MinHeight="26">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="40" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Number}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource Glyph}" Text="{c:Glyph Speaker216}" x:Name="Speaker" Margin="0,0,6,0" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
        <TextBlock x:Name="Name" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <TextBlock Grid.Column="2" Margin="12,0" Style="{StaticResource Caption}" Text="{Binding Subtitle}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="3" Margin="8,0" Style="{StaticResource Caption}" Text="{Binding RatingText}" VerticalAlignment="Center" />
      <TextBlock Style="{StaticResource GlyphFilled}" Text="{c:Glyph Star16, Filled=True}" Grid.Column="4" Margin="6,0" FontSize="12" Foreground="{StaticResource RatingBrush}" Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsPlaying}" Value="True">
        <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
        <Setter TargetName="Speaker" Property="Visibility" Value="Visible" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
