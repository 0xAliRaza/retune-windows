<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:Retune.App.Controls">

  <!-- ================================================================ tokens -->
  <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
  <CornerRadius x:Key="TileRadius">10</CornerRadius>
  <CornerRadius x:Key="RowRadius">6</CornerRadius>
  <Color x:Key="ShadowColor">#000000</Color>
  <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#99000000" />
  <SolidColorBrush x:Key="RatingBrush" Color="#FFD54F" />
  <SolidColorBrush x:Key="HeartBrush" Color="#FF5C8A" />
  <SolidColorBrush x:Key="LiveBrush" Color="#E53935" />

  <c:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <c:HasValueToVisibilityConverter x:Key="HasValueToVisibility" />
  <c:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />
  <c:EqualsConverter x:Key="Equals" />
  <c:CountConverter x:Key="Count" />

  <!-- ================================================================ typography -->
  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="ColumnTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>
  <Style x:Key="SectionHeader" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="12,16,12,6" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
  </Style>
  <Style x:Key="Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- ================================================================ artwork -->
  <Style TargetType="c:ArtworkImage">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:ArtworkImage">
          <Grid ClipToBounds="True">
            <Border Background="{TemplateBinding Placeholder}" Visibility="{TemplateBinding ShowPlaceholder, Converter={StaticResource BoolToVisibility}}">
              <TextBlock
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontFamily="{StaticResource DisplayFont}"
                  FontSize="26"
                  FontWeight="Bold"
                  Foreground="#E6FFFFFF"
                  Text="{TemplateBinding Initials}" />
            </Border>
            <Image x:Name="PART_Image" RenderOptions.BitmapScalingMode="HighQuality" Source="{TemplateBinding Image}" Stretch="{TemplateBinding Stretch}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ navigation rows (sidebar + categories) -->
  <Style x:Key="NavRow" TargetType="Button">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Margin" Value="6,1" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Back" Background="Transparent" CornerRadius="{StaticResource RowRadius}" />
            <Border
                x:Name="Pill"
                Width="3"
                Height="16"
                Margin="0,0,0,0"
                HorizontalAlignment="Left"
                Background="{DynamicResource AccentFillColorDefaultBrush}"
                CornerRadius="2"
                Visibility="Collapsed" />
            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            <Border x:Name="Focus" BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" BorderThickness="2" CornerRadius="{StaticResource RowRadius}" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CountBadge" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ================================================================ tiles -->
  <Style x:Key="TileButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    <Setter Property="RenderTransform">
      <Setter.Value>
        <ScaleTransform />
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.03" Duration="0:0:0.15">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.03" Duration="0:0:0.15">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.15" />
                  <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.15" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A frame for tile artwork: rounded, clipped, soft shadow that deepens on hover, accent ring on focus. -->
  <Style x:Key="TileFrame" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource TileRadius}" />
    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="6" Opacity="0.18" ShadowDepth="3" Direction="270" Color="{StaticResource ShadowColor}" />
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
        <Setter Property="Effect">
          <Setter.Value>
            <DropShadowEffect BlurRadius="18" Opacity="0.38" ShadowDepth="8" Direction="270" Color="{StaticResource ShadowColor}" />
          </Setter.Value>
        </Setter>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="FocusRing" TargetType="Border">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Margin" Value="-3" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="TileProgress" TargetType="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="1" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="PART_Track" Background="#80000000">
            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource AccentFillColorDefaultBrush}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ListProgress" TargetType="ProgressBar" BasedOn="{StaticResource TileProgress}">
    <Setter Property="Height" Value="3" />
    <Setter Property="Width" Value="60" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border CornerRadius="1.5" Background="{DynamicResource ControlStrokeColorDefaultBrush}" ClipToBounds="True">
            <Grid x:Name="PART_Track">
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="1.5" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Hover-only overlays inside a tile button. -->
  <Style x:Key="HoverOnly" TargetType="FrameworkElement">
    <Setter Property="Opacity" Value="0" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
        <Setter Property="Opacity" Value="1" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ================================================================ list rows -->
  <Style x:Key="ListRow" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Back" Margin="6,1" Padding="14,4" Background="Transparent" CornerRadius="{StaticResource RowRadius}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorSelectedTextBackgroundBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ toolbar -->
  <Style x:Key="ToolbarButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
    <Setter Property="Appearance" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style x:Key="SegmentButton" TargetType="ToggleButton">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Back" Background="Transparent" CornerRadius="5">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
