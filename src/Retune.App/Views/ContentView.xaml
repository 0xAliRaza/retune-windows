<UserControl
    x:Class="Retune.App.Views.ContentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Retune.Presentation.ViewModels;assembly=Retune.Presentation"
    x:Name="Root">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Retune;component/Themes/Tiles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid x:Name="Body" SizeChanged="OnSizeChanged">
    <!-- ================================================ grid -->
    <ItemsControl
        x:Name="GridItems"
        ItemsSource="{Binding Content.Rows}"
        Visibility="Collapsed"
        VirtualizingPanel.IsVirtualizing="True"
        VirtualizingPanel.VirtualizationMode="Recycling"
        VirtualizingPanel.ScrollUnit="Pixel"
        ScrollViewer.CanContentScroll="True"
        KeyboardNavigation.DirectionalNavigation="None"
        PreviewKeyDown="OnGridKeyDown">
      <ItemsControl.Template>
        <ControlTemplate TargetType="ItemsControl">
          <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </ItemsControl.Template>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel Margin="18,8,18,24" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:TileRow}">
          <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,18">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" Columns="{Binding DataContext.Content.Columns, ElementName=Root}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:BrowseItemViewModel}">
                <Button
                    Margin="6,0"
                    Style="{StaticResource TileButton}"
                    Tag="{Binding DataContext, ElementName=Root}"
                    ContextMenuOpening="OnItemContextMenuOpening"
                    Command="{Binding DataContext.OpenCommand, ElementName=Root}"
                    CommandParameter="{Binding}"
                    ContentTemplateSelector="{StaticResource TileSelector}"
                    Content="{Binding}"
                    AutomationProperties.Name="{Binding Title}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- ================================================ list / compact -->
    <ListBox
        x:Name="ListItems"
        ItemsSource="{Binding Content.Items}"
        Visibility="Collapsed"
        Background="Transparent"
        BorderThickness="0"
        Padding="8,0,8,16"
        VirtualizingPanel.IsVirtualizing="True"
        VirtualizingPanel.VirtualizationMode="Recycling"
        VirtualizingPanel.ScrollUnit="Pixel"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        KeyboardNavigation.TabNavigation="Once">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Padding" Value="0" />
          <Setter Property="Focusable" Value="False" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <ContentPresenter />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:BrowseItemViewModel}">
          <Button
              x:Name="Row"
              Style="{StaticResource ListRow}"
              Tag="{Binding DataContext, ElementName=Root}"
              ContextMenuOpening="OnItemContextMenuOpening"
              Command="{Binding DataContext.OpenCommand, ElementName=Root}"
              CommandParameter="{Binding}"
              Content="{Binding}"
              ContentTemplate="{StaticResource ListRowTemplate}"
              AutomationProperties.Name="{Binding Title}" />
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding DataContext.Content.Layout, ElementName=Root}" Value="Compact">
              <Setter TargetName="Row" Property="ContentTemplate" Value="{StaticResource CompactRowTemplate}" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- ================================================ states -->
    <StackPanel
        x:Name="StatusPanel"
        MaxWidth="460"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Visibility="Collapsed">
      <ui:ProgressRing x:Name="Spinner" Width="44" Height="44" Margin="0,0,0,18" IsIndeterminate="True" Visibility="Collapsed" />
      <ui:SymbolIcon x:Name="StatusIcon" Margin="0,0,0,14" FontSize="44" Symbol="Tv24" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
      <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Content.StatusTitle}" TextAlignment="Center" TextWrapping="Wrap" />
      <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource Caption}" FontSize="14" Text="{Binding Content.StatusMessage}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="None" />
      <StackPanel x:Name="FailedActions" Margin="0,20,0,0" HorizontalAlignment="Center" Orientation="Horizontal" Visibility="Collapsed">
        <ui:Button Appearance="Primary" Command="{Binding RefreshCommand}" Content="Try Again" />
        <ui:Button Margin="10,0,0,0" Command="{Binding EditPlaylistCommand}" CommandParameter="{Binding Playlists.Active}" Content="Edit Playlist…" />
      </StackPanel>
    </StackPanel>

    <!-- ================================================ locked -->
    <StackPanel x:Name="LockedPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
      <ui:SymbolIcon HorizontalAlignment="Center" FontSize="44" Symbol="LockClosed24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="This category is locked" />
      <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource Caption}" FontSize="14" Text="Enter your PIN to view it. It locks again when Retune quits, or with Ctrl+L." />
      <StackPanel x:Name="UnlockRow" Margin="0,18,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
        <StackPanel.RenderTransform><TranslateTransform x:Name="Shake" /></StackPanel.RenderTransform>
        <ui:PasswordBox x:Name="PinBox" Width="160" PlaceholderText="PIN" KeyDown="OnPinKeyDown" />
        <ui:Button Margin="8,0,0,0" Appearance="Primary" Content="Unlock" Click="OnUnlock" />
      </StackPanel>
      <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding UnlockError}" Visibility="{Binding UnlockError, Converter={StaticResource HasValueToVisibility}}" />
    </StackPanel>
  </Grid>
</UserControl>
