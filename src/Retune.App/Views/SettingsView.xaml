<UserControl
    x:Class="Retune.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Retune.Presentation.ViewModels;assembly=Retune.Presentation"
    xmlns:v="clr-namespace:Retune.App.Views"
    AutomationProperties.Name="Settings">
  <UserControl.Resources>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="Margin" Value="2,26,0,8" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="Card" TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel MaxWidth="860" Margin="36,20,36,36">
      <DockPanel>
        <ui:Button DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center" Appearance="Transparent" Command="{Binding DataContext.CloseSettingsCommand, RelativeSource={RelativeSource AncestorType=v:ShellView}}" Icon="{ui:SymbolIcon ArrowLeft24}" ToolTip="Back (Esc)" AutomationProperties.Name="Back" />
        <TextBlock Style="{StaticResource PageTitle}" Text="Settings" />
      </DockPanel>

      <!-- ===================================================== Appearance -->
      <TextBlock Style="{StaticResource SectionHeader}" Text="Appearance" />
      <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon ZoomIn24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontSize="14" Text="Zoom" />
            <TextBlock Style="{StaticResource Hint}" Text="Ctrl+Plus and Ctrl+Minus, or Ctrl + mouse wheel. Ctrl+0 resets." />
          </StackPanel>
        </ui:CardControl.Header>
        <ComboBox MinWidth="120" ItemsSource="{x:Static vm:SettingsViewModel.ZoomOptions}" SelectedItem="{Binding SelectedZoom}" DisplayMemberPath="Label" AutomationProperties.Name="Zoom" />
      </ui:CardControl>

      <!-- ===================================================== Playback -->
      <TextBlock Style="{StaticResource SectionHeader}" Text="Playback" />
      <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon Live24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontSize="14" Text="Live stream format" />
            <TextBlock Style="{StaticResource Hint}" Text="Try HLS if a channel keeps freezing; MPEG-TS starts faster." />
          </StackPanel>
        </ui:CardControl.Header>
        <ComboBox MinWidth="220" ItemsSource="{Binding LiveFormats}" SelectedItem="{Binding SelectedLiveFormat}" DisplayMemberPath="Label" AutomationProperties.Name="Live stream format" />
      </ui:CardControl>
      <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon Next24}">
        <ui:CardControl.Header>
          <TextBlock FontSize="14" Text="Play the next episode automatically" />
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding AutoplayNext}" AutomationProperties.Name="Play the next episode automatically" />
      </ui:CardControl>
      <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon PictureInPicture24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontSize="14" Text="Picture in picture when switching apps" />
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Keep watching in a small window on top while you use another app. Press P in the player to switch it yourself." />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding AutoPictureInPicture}" AutomationProperties.Name="Picture in picture when switching apps" />
      </ui:CardControl>
      <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon LockOpen24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontSize="14" Text="Allow unverified HTTPS streams" />
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Only for a provider you trust whose certificate Windows can't verify. Anyone on the network could then read your login." />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding AllowUnverifiedHttps}" AutomationProperties.Name="Allow unverified HTTPS streams" />
      </ui:CardControl>

      <!-- ===================================================== Parental PIN -->
      <TextBlock Style="{StaticResource SectionHeader}" Text="Parental PIN" />
      <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon ShieldLock24}">
        <ui:CardControl.Header>
          <Grid>
            <StackPanel Orientation="Horizontal" Visibility="{Binding HasPin, Converter={StaticResource BoolToVisibility}}">
              <ui:SymbolIcon Margin="0,0,6,0" Symbol="ShieldCheckmark20" Filled="True" Foreground="#3FB950" />
              <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="#3FB950" Text="PIN is set" />
            </StackPanel>
            <StackPanel Visibility="{Binding HasPin, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
              <TextBlock FontSize="14" Text="No PIN" />
              <TextBlock Style="{StaticResource Hint}" Text="Lock categories by right-clicking them in the category list." />
            </StackPanel>
          </Grid>
        </ui:CardControl.Header>
        <Grid>
          <StackPanel Orientation="Horizontal" Visibility="{Binding HasPin, Converter={StaticResource BoolToVisibility}}">
            <ui:Button Content="Change…" Command="{Binding ChangePinCommand}" />
            <ui:Button Margin="8,0,0,0" Content="Remove…" Command="{Binding RemovePinCommand}" />
          </StackPanel>
          <ui:Button Appearance="Primary" Content="Set PIN…" Command="{Binding SetPinCommand}" Visibility="{Binding HasPin, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
        </Grid>
      </ui:CardControl>

      <!-- ===================================================== Hidden categories -->
      <TextBlock Style="{StaticResource SectionHeader}" Text="Hidden categories" />
      <!-- Collapsed by default: the names of hidden categories stay out of sight until asked for. -->
      <ui:CardExpander IsExpanded="False" Icon="{ui:SymbolIcon EyeOff24}" AutomationProperties.Name="Hidden categories">
        <ui:CardExpander.Header>
          <StackPanel>
            <TextBlock FontSize="14" Text="Hidden categories" />
            <TextBlock Style="{StaticResource Hint}" Text="{Binding HiddenSummary}" />
          </StackPanel>
        </ui:CardExpander.Header>
        <StackPanel>
          <TextBlock Style="{StaticResource Hint}" FontSize="13" Text="Right-click a category and choose Hide to tidy up the list." Visibility="{Binding HasHiddenCategories, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
          <ItemsControl Focusable="False" ItemsSource="{Binding HiddenCategories}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:HiddenCategoryRow}">
                <DockPanel Margin="0,3">
                  <ui:Button DockPanel.Dock="Right" Content="Show" Command="{Binding DataContext.ShowCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Show {0}}" />
                  <ui:SymbolIcon x:Name="Icon" Margin="0,0,12,0" FontSize="16" Symbol="Live24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Section}" Value="Movies"><Setter TargetName="Icon" Property="Symbol" Value="MoviesAndTv24" /></DataTrigger>
                  <DataTrigger Binding="{Binding Section}" Value="Series"><Setter TargetName="Icon" Property="Symbol" Value="SlideMultiple24" /></DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ui:CardExpander>

      <!-- ===================================================== History and storage -->
      <TextBlock Style="{StaticResource SectionHeader}" Text="History and storage" />
      <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon History24}" IsEnabled="{Binding HasActivePlaylist}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontSize="14" Text="Watch history" />
            <TextBlock Style="{StaticResource Hint}" Text="{Binding ActivePlaylistName, StringFormat=Continue Watching and Recently Watched for {0}}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:Button Appearance="Danger" Content="Clear…" Command="{Binding ClearHistoryCommand}" />
      </ui:CardControl>
      <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon Image24}">
        <ui:CardControl.Header>
          <TextBlock FontSize="14" Text="Cached posters and logos" />
        </ui:CardControl.Header>
        <ui:Button Content="{Binding ArtworkButtonLabel}" Command="{Binding ClearArtworkCommand}" />
      </ui:CardControl>

      <!-- ===================================================== Help -->
      <TextBlock Style="{StaticResource SectionHeader}" Text="Help" />
      <ui:CardControl Style="{StaticResource Card}" Icon="{ui:SymbolIcon Keyboard24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock FontSize="14" Text="Keyboard shortcuts" />
            <TextBlock Style="{StaticResource Hint}" Text="F1, Ctrl+/ or ? anywhere in Retune." />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:Button Content="Show" Command="{Binding ShowShortcutsCommand}" />
      </ui:CardControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
