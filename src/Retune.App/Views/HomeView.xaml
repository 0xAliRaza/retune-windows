<UserControl
    x:Class="Retune.App.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Retune.Presentation.ViewModels;assembly=Retune.Presentation"
    x:Name="Root"
    AutomationProperties.Name="Home">
  <UserControl.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="/Retune;component/Themes/Tiles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- Tile widths per artwork shape; the tile templates size their artwork from the width. -->
    <Style x:Key="HomeTile" TargetType="Button" BasedOn="{StaticResource TileButton}">
      <Setter Property="Width" Value="176" />
      <Setter Property="Margin" Value="0,0,14,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Style}" Value="Logo"><Setter Property="Width" Value="196" /></DataTrigger>
        <DataTrigger Binding="{Binding Style}" Value="Landscape"><Setter Property="Width" Value="300" /></DataTrigger>
      </Style.Triggers>
    </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollViewer x:Name="Page" VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="32,20,0,32">
      <TextBlock Style="{StaticResource PageTitle}" Text="Home" />
      <TextBlock Margin="0,4,0,8" Style="{StaticResource Caption}" Text="{Binding Playlists.Active.Name}" />

      <!-- nothing yet -->
      <StackPanel Margin="0,80,32,0" HorizontalAlignment="Center" Visibility="{Binding Home.IsEmpty, Converter={StaticResource BoolToVisibility}}">
        <ui:SymbolIcon HorizontalAlignment="Center" FontSize="44" Symbol="Home24" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Your favourites and progress live here" />
        <TextBlock Margin="0,8,0,0" MaxWidth="440" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource Caption}" FontSize="14"
                   Text="Star channels, films and series to keep them close, and whatever you start watching appears here so you can pick up where you left off." />
      </StackPanel>

      <ItemsControl Focusable="False" ItemsSource="{Binding Home.Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:HomeRow}">
            <StackPanel Margin="0,22,0,0">
              <DockPanel Margin="0,0,32,10">
                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Content="{Binding SeeAllLabel}" Click="OnSeeAll" Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" />
              </DockPanel>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False" PreviewMouseWheel="OnRowWheel">
                <ItemsControl Margin="0,0,0,8" Focusable="False" ItemsSource="{Binding Items}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BrowseItemViewModel}">
                      <Button
                          Style="{StaticResource HomeTile}"
                          Tag="{Binding DataContext, ElementName=Root}"
                          ContextMenu="{StaticResource ItemMenu}"
                          Command="{Binding DataContext.OpenCommand, ElementName=Root}"
                          CommandParameter="{Binding}"
                          ContentTemplateSelector="{StaticResource TileSelector}"
                          Content="{Binding}"
                          AutomationProperties.Name="{Binding Title}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
