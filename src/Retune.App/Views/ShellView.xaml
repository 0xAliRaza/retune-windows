<UserControl
    x:Class="Retune.App.Views.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:v="clr-namespace:Retune.App.Views"
    xmlns:vm="clr-namespace:Retune.Presentation.ViewModels;assembly=Retune.Presentation"
    x:Name="Root"
    FontFamily="{StaticResource AppFont}">
  <Grid>
    <!-- ======================================================= browser -->
    <Grid x:Name="Browser" Visibility="{Binding HasPlaylists, Converter={StaticResource BoolToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="232" />
        <ColumnDefinition Width="272" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- sidebar -->
      <DockPanel Grid.Column="0" Background="{DynamicResource LayerOnMicaBaseAltFillColorTransparentBrush}">
        <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,14">
          <StackPanel Margin="6,0,6,10" Visibility="{Binding Playlists.Account, Converter={StaticResource HasValueToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon x:Name="AccountIcon" Symbol="PersonAvailable16" FontSize="13" Foreground="#3FB950" />
              <TextBlock Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#3FB950" Text="{Binding Playlists.Account.Status}" />
            </StackPanel>
            <TextBlock Margin="0,3,0,0" Style="{StaticResource Caption}" FontSize="11" Text="{Binding Playlists.Account.ExpiresAt, StringFormat=Expires {0:d MMM yyyy}}" Visibility="{Binding Playlists.Account.ExpiresAt, Converter={StaticResource HasValueToVisibility}}" />
            <TextBlock Style="{StaticResource Caption}" FontSize="11" Text="{Binding Playlists.Account.MaxConnections, StringFormat={}{0} connection(s) allowed}" Visibility="{Binding Playlists.Account.MaxConnections, Converter={StaticResource HasValueToVisibility}}" />
          </StackPanel>
          <ui:Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Appearance="Transparent" Command="{Binding AddPlaylistCommand}" Icon="{ui:SymbolIcon AddCircle24}" Content="Add Playlist" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="18,14,12,6" Orientation="Horizontal">
          <Border Width="28" Height="28" CornerRadius="7">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#8B5CF6" />
                <GradientStop Offset="1" Color="#3B82F6" />
              </LinearGradientBrush>
            </Border.Background>
            <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="15" Foreground="White" Margin="2,0,0,0" />
          </Border>
          <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Retune" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionHeader}" Text="Library" Margin="18,16,12,6" />
            <ItemsControl ItemsSource="{Binding Sections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SectionItem}">
                  <Button Style="{StaticResource NavRow}" Command="{Binding DataContext.SelectSectionCommand, ElementName=Root}" CommandParameter="{Binding Section}">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Style="{StaticResource CountBadge}" Text="{Binding Count, Converter={StaticResource Count}}" />
                      <ui:SymbolIcon x:Name="Icon" Symbol="Live24" FontSize="18" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                      <TextBlock Style="{StaticResource Body}" Text="{Binding Title}" VerticalAlignment="Center" />
                    </DockPanel>
                  </Button>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Section}" Value="Movies"><Setter TargetName="Icon" Property="Symbol" Value="Filmstrip24" /></DataTrigger>
                    <DataTrigger Binding="{Binding Section}" Value="Series"><Setter TargetName="Icon" Property="Symbol" Value="MoviesAndTv24" /></DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" /></DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Playlists" Margin="18,20,12,6" />
            <ItemsControl ItemsSource="{Binding PlaylistItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:PlaylistItem}">
                  <Button Style="{StaticResource NavRow}" MinHeight="44" Command="{Binding DataContext.SelectPlaylistCommand, ElementName=Root}" CommandParameter="{Binding Playlist}">
                    <Button.ContextMenu>
                      <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Use This Playlist" Command="{Binding Source={x:Reference Root}, Path=DataContext.SelectPlaylistCommand}" CommandParameter="{Binding Playlist}" />
                        <MenuItem Header="Edit…" Command="{Binding Source={x:Reference Root}, Path=DataContext.EditPlaylistCommand}" CommandParameter="{Binding Playlist}" />
                        <Separator />
                        <MenuItem Header="Delete…" Command="{Binding Source={x:Reference Root}, Path=DataContext.DeletePlaylistCommand}" CommandParameter="{Binding Playlist}" />
                      </ContextMenu>
                    </Button.ContextMenu>
                    <DockPanel>
                      <ui:SymbolIcon x:Name="Check" Symbol="Circle20" FontSize="16" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Body}" Text="{Binding Name}" />
                        <TextBlock Style="{StaticResource Caption}" FontSize="11" Text="{Binding KindLabel}" />
                      </StackPanel>
                    </DockPanel>
                  </Button>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                      <Setter TargetName="Check" Property="Symbol" Value="CheckmarkCircle20" />
                      <Setter TargetName="Check" Property="Filled" Value="True" />
                      <Setter TargetName="Check" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <!-- category column -->
      <Border Grid.Column="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,1,0" Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="16,18,16,8">
            <TextBlock Style="{StaticResource ColumnTitle}" Text="{Binding Categories.SectionTitle}" />
            <ui:TextBox Margin="0,12,0,0" PlaceholderText="Filter categories" Icon="{ui:SymbolIcon Filter24}" Text="{Binding Categories.FilterText, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <Button DockPanel.Dock="Bottom" Margin="6,4,6,12" Style="{StaticResource NavRow}" Visibility="{Binding Categories.HiddenCount, Converter={StaticResource HasValueToVisibility}}" ToolTip="Manage hidden categories in Settings">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="EyeOff16" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <TextBlock Margin="8,0,0,0" Style="{StaticResource Caption}" Text="{Binding Categories.HiddenCount, StringFormat={}{0} hidden}" />
            </StackPanel>
          </Button>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,8">
              <ItemsControl ItemsSource="{Binding Categories.Fixed}" ItemTemplate="{DynamicResource CategoryRowTemplate}" />
              <TextBlock Style="{StaticResource SectionHeader}" Text="Pinned" Visibility="{Binding Categories.Pinned.Count, Converter={StaticResource HasValueToVisibility}}" />
              <ItemsControl ItemsSource="{Binding Categories.Pinned}" ItemTemplate="{DynamicResource CategoryRowTemplate}" />
              <TextBlock Style="{StaticResource SectionHeader}" Text="Categories" />
              <ItemsControl ItemsSource="{Binding Categories.Categories}" ItemTemplate="{DynamicResource CategoryRowTemplate}" VirtualizingPanel.IsVirtualizing="True" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- content -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,14,20,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ui:Button Appearance="Transparent" Margin="-8,0,8,0" Command="{Binding BackCommand}" Icon="{ui:SymbolIcon ArrowLeft24}" Content="{Binding Content.Title}" ToolTip="Back (Alt+Left, Esc)" FontSize="14" Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock x:Name="ContentTitle" Style="{StaticResource PageTitle}" Text="{Binding Content.Title}" Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <ui:TextBox x:Name="SearchBox" Width="280" Margin="0,0,10,0" PlaceholderText="{Binding SearchPlaceholder}" Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button Style="{StaticResource ToolbarButton}" Command="{Binding RefreshCommand}" Icon="{ui:SymbolIcon ArrowSync24}" ToolTip="Refresh playlist (F5)" Visibility="{Binding Playlists.IsRefreshing, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
            <ui:ProgressRing Width="18" Height="18" Margin="9,0" IsIndeterminate="True" Visibility="{Binding Playlists.IsRefreshing, Converter={StaticResource BoolToVisibility}}" />
            <Border Margin="6,0" Padding="2" CornerRadius="7" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <ToggleButton Style="{StaticResource SegmentButton}" ToolTip="Grid (Ctrl+Shift+1)" IsChecked="{Binding Content.Layout, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Grid}" Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static vm:ContentViewModel.GridLayout}">
                  <ui:SymbolIcon Symbol="GridDots24" FontSize="16" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource SegmentButton}" ToolTip="List (Ctrl+Shift+2)" IsChecked="{Binding Content.Layout, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=List}" Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static vm:ContentViewModel.ListLayout}">
                  <ui:SymbolIcon Symbol="AppsList24" FontSize="16" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource SegmentButton}" ToolTip="Compact (Ctrl+Shift+3)" IsChecked="{Binding Content.Layout, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Compact}" Command="{Binding SetLayoutCommand}" CommandParameter="{x:Static vm:ContentViewModel.CompactLayout}">
                  <ui:SymbolIcon Symbol="TextBulletListLtr24" FontSize="16" />
                </ToggleButton>
              </StackPanel>
            </Border>
            <ui:Button x:Name="SortButton" Style="{StaticResource ToolbarButton}" Icon="{ui:SymbolIcon ArrowSortDownLines24}" ToolTip="Sort and tile size" Click="OnSortClick" />
          </StackPanel>
        </Grid>

        <v:ContentView Grid.Row="1" Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
        <ContentControl Grid.Row="1" Content="{Binding Detail}" Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}">
          <ContentControl.Resources>
            <DataTemplate DataType="{x:Type vm:MovieDetailViewModel}"><v:MovieDetailView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SeriesDetailViewModel}"><v:SeriesDetailView /></DataTemplate>
          </ContentControl.Resources>
        </ContentControl>
      </Grid>
    </Grid>

    <!-- ======================================================= welcome -->
    <v:WelcomeView Visibility="{Binding HasPlaylists, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
  </Grid>

  <UserControl.Resources>
    <DataTemplate x:Key="CategoryRowTemplate" DataType="{x:Type vm:CategoryRow}">
      <Button Style="{StaticResource NavRow}" MinHeight="34" Command="{Binding DataContext.SelectCategoryCommand, ElementName=Root}" CommandParameter="{Binding}">
        <Button.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Pin to Top" Command="{Binding Source={x:Reference Root}, Path=DataContext.TogglePinCommand}" CommandParameter="{Binding}" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"><MenuItem.Icon><ui:SymbolIcon Symbol="Pin24" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Unpin" Command="{Binding Source={x:Reference Root}, Path=DataContext.TogglePinCommand}" CommandParameter="{Binding}" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}"><MenuItem.Icon><ui:SymbolIcon Symbol="PinOff24" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Lock with PIN" Command="{Binding Source={x:Reference Root}, Path=DataContext.LockCommand}" CommandParameter="{Binding}" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"><MenuItem.Icon><ui:SymbolIcon Symbol="LockClosed24" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Remove Lock…" Command="{Binding Source={x:Reference Root}, Path=DataContext.RemoveLockCommand}" CommandParameter="{Binding}" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}"><MenuItem.Icon><ui:SymbolIcon Symbol="LockOpen16" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Hide Category" Command="{Binding Source={x:Reference Root}, Path=DataContext.HideCommand}" CommandParameter="{Binding}"><MenuItem.Icon><ui:SymbolIcon Symbol="EyeOff24" /></MenuItem.Icon></MenuItem>
          </ContextMenu>
        </Button.ContextMenu>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Style="{StaticResource CountBadge}" Text="{Binding CountText}" />
          <ui:SymbolIcon x:Name="Lock" DockPanel.Dock="Right" Margin="6,0" Symbol="LockClosed16" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />
          <ui:SymbolIcon x:Name="Icon" Margin="0,0,10,0" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
          <TextBlock Style="{StaticResource Body}" Text="{Binding Title}" VerticalAlignment="Center" />
        </DockPanel>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="All"><Setter TargetName="Icon" Property="Symbol" Value="GridDots24" /><Setter TargetName="Icon" Property="Visibility" Value="Visible" /></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Favorites"><Setter TargetName="Icon" Property="Symbol" Value="Star24" /><Setter TargetName="Icon" Property="Visibility" Value="Visible" /></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="ContinueWatching"><Setter TargetName="Icon" Property="Symbol" Value="PlayCircle24" /><Setter TargetName="Icon" Property="Visibility" Value="Visible" /></DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Recent"><Setter TargetName="Icon" Property="Symbol" Value="History24" /><Setter TargetName="Icon" Property="Visibility" Value="Visible" /></DataTrigger>
        <DataTrigger Binding="{Binding IsUnlocked}" Value="True"><Setter TargetName="Lock" Property="Symbol" Value="LockOpen16" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>
</UserControl>
