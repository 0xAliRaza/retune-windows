<UserControl
    x:Class="Retune.App.Views.WelcomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Grid>
    <StackPanel MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border Width="88" Height="88" HorizontalAlignment="Center" CornerRadius="22">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#8B5CF6" />
            <GradientStop Offset="1" Color="#3B82F6" />
          </LinearGradientBrush>
        </Border.Background>
        <Border.Effect><DropShadowEffect BlurRadius="30" Opacity="0.45" ShadowDepth="8" Direction="270" Color="#3B82F6" /></Border.Effect>
        <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="44" Foreground="White" Margin="5,0,0,0" />
      </Border>
      <TextBlock Margin="0,28,0,0" HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Welcome to Retune" />
      <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Add your IPTV subscription to start watching live TV, movies and series." TextAlignment="Center" TextWrapping="Wrap" />
      <ui:Button Margin="0,26,0,0" Padding="24,12" HorizontalAlignment="Center" Appearance="Primary" FontSize="15" Icon="{ui:SymbolIcon Add24}" Content="Add Playlist" Command="{Binding AddPlaylistCommand}" />
      <UniformGrid Margin="0,40,0,0" Columns="3">
        <StackPanel Margin="12,0">
          <ui:SymbolIcon HorizontalAlignment="Center" Symbol="Server24" FontSize="26" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Xtream Codes" />
          <TextBlock HorizontalAlignment="Center" Style="{StaticResource Caption}" Text="Server, username &amp; password" />
        </StackPanel>
        <StackPanel Margin="12,0">
          <ui:SymbolIcon HorizontalAlignment="Center" Symbol="Link24" FontSize="26" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="M3U URL" />
          <TextBlock HorizontalAlignment="Center" Style="{StaticResource Caption}" Text="A playlist link from your provider" />
        </StackPanel>
        <StackPanel Margin="12,0">
          <ui:SymbolIcon HorizontalAlignment="Center" Symbol="Document24" FontSize="26" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="M3U File" />
          <TextBlock HorizontalAlignment="Center" Style="{StaticResource Caption}" Text="A .m3u file on this PC" />
        </StackPanel>
      </UniformGrid>
      <TextBlock Margin="0,36,0,0" HorizontalAlignment="Center" Style="{StaticResource Caption}" Text="Retune is only a player. You bring your own legal source." />
    </StackPanel>
  </Grid>
</UserControl>
