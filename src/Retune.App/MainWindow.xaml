<ui:FluentWindow
    x:Class="Retune.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:v="clr-namespace:Retune.App.Views"
    xmlns:video="clr-namespace:Retune.App.Video"
    Title="Retune"
    Icon="/Assets/Retune.ico"
    Width="1360"
    Height="860"
    MinWidth="980"
    MinHeight="620"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Retune">
      <ui:TitleBar.Icon><ui:ImageIcon Source="/Assets/Retune.ico" /></ui:TitleBar.Icon>
    </ui:TitleBar>
    <v:ShellView x:Name="ShellPane" Grid.Row="1" />

    <!-- The player: one video window for the app's lifetime, with the chrome in a transparent layer above it. -->
    <Grid x:Name="PlayerLayer" Grid.Row="1">
      <video:VideoHost x:Name="Video" Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top" />
      <video:OverlayHost x:Name="Overlay" Visibility="Collapsed">
        <v:PlayerView x:Name="PlayerChrome" />
      </video:OverlayHost>
    </Grid>

    <!-- modal dialog layer -->
    <Grid x:Name="DialogLayer" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
      <Border Background="#99000000" MouseLeftButtonDown="OnBackdropClick" />
      <Border
          MaxHeight="760"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
          BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="10">
        <Border.Effect><DropShadowEffect BlurRadius="40" Opacity="0.5" ShadowDepth="12" Direction="270" /></Border.Effect>
        <ContentControl x:Name="DialogHost" Focusable="False" />
      </Border>
    </Grid>
  </Grid>
</ui:FluentWindow>
