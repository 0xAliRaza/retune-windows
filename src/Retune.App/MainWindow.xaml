<ui:FluentWindow
    x:Class="Retune.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:v="clr-namespace:Retune.App.Views"
    Title="Retune"
    Width="1360"
    Height="860"
    MinWidth="980"
    MinHeight="620"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Retune" ShowMinimize="True" ShowMaximize="True" />
    <v:ShellView x:Name="Shell" Grid.Row="1" />

    <!-- modal dialog layer -->
    <Grid x:Name="DialogLayer" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
      <Border Background="#99000000" MouseLeftButtonDown="OnBackdropClick" />
      <Border
          MaxHeight="760"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
          BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="10">
        <Border.Effect><DropShadowEffect BlurRadius="40" Opacity="0.5" ShadowDepth="12" Direction="270" /></Border.Effect>
        <ContentControl x:Name="DialogHost" Focusable="False" />
      </Border>
    </Grid>
  </Grid>
</ui:FluentWindow>
