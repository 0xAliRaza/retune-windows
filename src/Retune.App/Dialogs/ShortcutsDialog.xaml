<d:DialogBase
    x:Class="Retune.App.Dialogs.ShortcutsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:d="clr-namespace:Retune.App.Dialogs"
    xmlns:v="clr-namespace:Retune.App.Views">
  <StackPanel Margin="26">
    <DockPanel Margin="0,0,0,18">
      <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="Done" Click="OnCancel" IsCancel="True" IsDefault="True" />
      <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Keyboard Shortcuts" />
    </DockPanel>
    <v:ShortcutsSheet />
  </StackPanel>
</d:DialogBase>
